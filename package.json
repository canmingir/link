    "stylis": "^4.3.2",
    "stylis-plugin-rtl": "^2.1.1",
    "swr": "^2.2.5",
    "vite-plugin-checker": "^0.9.0",
    "vite-plugin-svgr": "^4.2.0",
    "use-sound": "^4.0.1",
    "yet-another-react-lightbox": "^3.21.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.21.5",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.29.7",
    "@chromatic-com/storybook": "^4.1.1",
    "@storybook/addon-a11y": "^9.1.8",
    "@storybook/addon-docs": "^9.1.8",
    "@storybook/addon-vitest": "^9.1.8",
    "@storybook/react-vite": "^9.1.8",
    "@types/autosuggest-highlight": "^3.2.4",
    "@types/bun": "^1.4.2",
    "@types/lodash": "^4.17.25",
    "@types/node": "^20",
    "@types/numeral": "^2.0.5",
    "@types/qs": "^6.15.1",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/react-lazy-load-image-component": "^1.6.5",
    "@typescript-eslint/eslint-plugin": "^8.70",
    "@typescript-eslint/parser": "^8.70",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "babel-jest": "^29.5.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^9.1.8",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "nodemon": "^3.0.1",
    "playwright": "^1.55.1",
    "prettier": "^2.8.8",
    "storybook": "^9.1.8",
    "typescript": "^5.7.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "react-is": "^18.3.1"
  }
}
