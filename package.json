{
  "name": "@canmingir/link",
  "version": "1.2.73",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "link-server": "./server/server.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layouts": {
      "types": "./dist/src/layouts/index.d.ts",
      "import": "./dist/src/layouts/index.js"
    },
    "./vite": {
      "types": "./dist/vite/vite.d.ts",
      "import": "./dist/vite/vite.js"
    },
    "./platform/components": {
      "types": "./dist/src/lib/index.d.ts",
      "import": "./dist/src/lib/index.js"
    },
    "./platform/hooks": {
      "types": "./dist/src/hooks/index.d.ts",
      "import": "./dist/src/hooks/index.js"
    },
    "./platform/cypress": {
      "types": "./dist/cypress/cypress.d.ts",
      "import": "./dist/cypress/cypress.js"
    },
    "./platform/commands": {
      "types": "./dist/commands/index.d.ts",
      "import": "./dist/commands/index.js"
    },
    "./platform/http": {
      "types": "./dist/src/http/index.d.ts",
      "import": "./dist/src/http/index.js"
    }
  },
  "files": [
    "dist",
    "server/server.ts",
    "server/tsconfig.json"
  ],
  "scripts": {
    "dev": "cd project && concurrently \"npm run dev\" \"npm run server\"",
    "dev:update": "cd project && npm i @nucleoidai/platform@latest",
    "test": "exit 0",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs && node scripts/fix-esm-extensions.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:cypress": "tsc --noEmit -p cypress/tsconfig.json",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "lint": "eslint \"{src,vite,commands}/**/*.{ts,tsx}\" \"*.ts\" \".storybook/**/*.ts\"",
    "lint:fix": "eslint --fix \"{src,vite,commands}/**/*.{ts,tsx}\" \"*.ts\" \".storybook/**/*.ts\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cypress": "cypress open --browser chrome"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.968.0",
    "@chatscope/chat-ui-kit-react": "^1.10.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@emoji-mart/data": "^1.1.2",
    "@emoji-mart/react": "^1.1.1",
    "@emotion/react": "^11.14.0",
