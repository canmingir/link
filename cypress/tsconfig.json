{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["cypress", "node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "isolatedModules": false
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "index.d.ts",
    "../commands/**/*.ts",
    "../cypress.config.ts",
    "../types/**/*.d.ts"
  ],
  "exclude": ["../node_modules"]
}
